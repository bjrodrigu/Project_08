# Copy to .env.local (gitignored) and fill in. CRA only exposes REACT_APP_* vars.

# Backend base URL. Defaults to http://localhost:8080 when unset.
REACT_APP_API_URL=http://localhost:8080

# Google Maps JavaScript API key (browser key; restrict it to your referrers).
# Only the Maps JavaScript API is needed; distances are computed locally.
REACT_APP_GOOGLE_MAPS_API_KEY=
